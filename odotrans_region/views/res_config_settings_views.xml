<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odotrans_region" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.odotrans.region</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ODOTRANS Regions" name="odotrans_region"
                     string="ODOTRANS Regions"
                     logo="/odotrans_base/static/description/icon.png">
                    <block title="Localization" name="odotrans_region_block">
                        <setting id="odotrans_default_region"
                                 string="Default Region"
                                 help="Region profile used for this company's units, currency, compliance and tax behaviour.">
                            <field name="odotrans_region_id"/>
                            <div class="content-group mt16" invisible="not odotrans_region_id">
                                <button name="%(action_region)d" type="action"
                                        string="Configure regions" class="btn-link"
                                        icon="fa-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
