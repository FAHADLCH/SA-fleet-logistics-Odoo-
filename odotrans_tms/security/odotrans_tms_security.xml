<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_odotrans_tms_user" model="res.groups">
        <field name="name">ODOTRANS / TMS User</field>
        <field name="category_id" ref="odotrans_base.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('odotrans_base.group_odotrans_user'))]"/>
    </record>
    <record id="group_odotrans_tms_manager" model="res.groups">
        <field name="name">ODOTRANS / TMS Manager</field>
        <field name="category_id" ref="odotrans_base.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('group_odotrans_tms_user')), (4, ref('odotrans_base.group_odotrans_manager'))]"/>
    </record>

    <!-- Multi-company isolation -->
    <record id="rule_shipment_company" model="ir.rule">
        <field name="name">Shipment: multi-company</field>
        <field name="model_id" ref="model_odotrans_shipment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
