<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rate_card_list" model="ir.ui.view">
        <field name="name">odotrans.rate.card.list</field>
        <field name="model">odotrans.rate.card</field>
        <field name="arch" type="xml">
            <list string="Rate Cards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="service_level"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_rate_card_form" model="ir.ui.view">
        <field name="name">odotrans.rate.card.form</field>
        <field name="model">odotrans.rate.card</field>
        <field name="arch" type="xml">
            <form string="Rate Card">
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. ACME Express"/></h1></div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="service_level"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="charge_type"/>
                            <field name="base_amount"/>
                            <field name="per_km"/>
                            <field name="per_kg"/>
                            <field name="min_amount"/>
                            <field name="max_amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rate_card" model="ir.actions.act_window">
        <field name="name">Rate Cards</field>
        <field name="res_model">odotrans.rate.card</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
