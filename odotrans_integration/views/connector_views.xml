<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_connector_list" model="ir.ui.view">
        <field name="name">odotrans.integration.connector.list</field>
        <field name="model">odotrans.integration.connector</field>
        <field name="arch" type="xml">
            <list string="Connectors" decoration-success="status == 'ok'"
                  decoration-danger="status == 'error'" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="provider" optional="show"/>
                <field name="auth_type" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'"
                       decoration-danger="status == 'error'"/>
                <field name="last_sync" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
                <button name="action_test_connection" type="object" string="Test"
                        icon="fa-plug" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_connector_form" model="ir.ui.view">
        <field name="name">odotrans.integration.connector.form</field>
        <field name="model">odotrans.integration.connector</field>
        <field name="arch" type="xml">
            <form string="Connector">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary" icon="fa-plug"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ok"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Samsara Fleet"/></h1>
                        <div>
                            <span class="o_form_label">Code: </span>
                            <field name="code" placeholder="samsara" class="oe_inline"/>
                        </div>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="category"/>
                            <field name="provider"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Health">
                            <field name="last_sync"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <group string="Authentication">
                        <field name="auth_type"/>
                        <field name="base_url" placeholder="https://api.vendor.com/v1"/>
                        <field name="api_key" password="True"
                               invisible="auth_type not in ('api_key','bearer')"/>
                        <field name="username" invisible="auth_type != 'basic'"/>
                        <field name="password" password="True" invisible="auth_type != 'basic'"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_connector_search" model="ir.ui.view">
        <field name="name">odotrans.integration.connector.search</field>
        <field name="model">odotrans.integration.connector</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="provider"/>
                <filter name="connected" string="Connected" domain="[('status', '=', 'ok')]"/>
                <filter name="errored" string="Errors" domain="[('status', '=', 'error')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_connector" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">odotrans.integration.connector</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_connector_search"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first integration</p>
            <p>Connect telematics, e-commerce, payment, accounting and customs systems.</p>
        </field>
    </record>
</odoo>
