<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_odotrans_integration_manager" model="res.groups">
        <field name="name">ODOTRANS Integration Manager</field>
        <field name="category_id" ref="odotrans_base.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('odotrans_base.group_odotrans_user'))]"/>
    </record>

    <record id="rule_odotrans_connector_company" model="ir.rule">
        <field name="name">ODOTRANS Connector: multi-company</field>
        <field name="model_id" ref="model_odotrans_integration_connector"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_odotrans_webhook_company" model="ir.rule">
        <field name="name">ODOTRANS Webhook: multi-company</field>
        <field name="model_id" ref="model_odotrans_webhook_endpoint"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_odotrans_edi_company" model="ir.rule">
        <field name="name">ODOTRANS EDI: multi-company</field>
        <field name="model_id" ref="model_odotrans_edi_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
