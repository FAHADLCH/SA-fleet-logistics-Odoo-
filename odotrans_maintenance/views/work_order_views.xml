<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_work_order_list" model="ir.ui.view">
        <field name="name">odotrans.work.order.list</field>
        <field name="model">odotrans.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Orders" decoration-info="state == 'in_progress'"
                  decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="order_type"/>
                <field name="service_type"/>
                <field name="scheduled_date"/>
                <field name="cost"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_work_order_form" model="ir.ui.view">
        <field name="name">odotrans.work.order.form</field>
        <field name="model">odotrans.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Complete"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="order_type"/>
                            <field name="service_type"/>
                            <field name="plan_id"/>
                            <field name="defect_id"/>
                        </group>
                        <group>
                            <field name="scheduled_date"/>
                            <field name="started_at"/>
                            <field name="completed_at"/>
                            <field name="odometer"/>
                            <field name="cost"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_work_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">odotrans.work.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
