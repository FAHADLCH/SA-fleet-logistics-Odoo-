<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_optrun_list" model="ir.ui.view">
        <field name="name">odotrans.optimization.run.list</field>
        <field name="model">odotrans.optimization.run</field>
        <field name="arch" type="xml">
            <list string="Optimization Runs" decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'" decoration-info="state in ('queued','running')">
                <field name="name"/>
                <field name="trip_id"/>
                <field name="provider"/>
                <field name="distance_m"/>
                <field name="duration_s"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_optrun_form" model="ir.ui.view">
        <field name="name">odotrans.optimization.run.form</field>
        <field name="model">odotrans.optimization.run</field>
        <field name="arch" type="xml">
            <form string="Optimization Run">
                <header>
                    <button name="action_optimize" type="object" string="Optimize"
                            class="oe_highlight" invisible="state in ('queued','running','done')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="provider" readonly="1"/>
                            <field name="depot_lat"/>
                            <field name="depot_lng"/>
                        </group>
                        <group>
                            <field name="distance_m" readonly="1"/>
                            <field name="duration_s" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_optrun" model="ir.actions.act_window">
        <field name="name">Optimization Runs</field>
        <field name="res_model">odotrans.optimization.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
