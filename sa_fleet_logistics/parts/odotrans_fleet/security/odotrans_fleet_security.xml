<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_odotrans_fleet_manager" model="res.groups">
        <field name="name">ODOTRANS / Fleet Manager</field>
        <field name="category_id" ref="sa_fleet_logistics.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('sa_fleet_logistics.group_odotrans_user'))]"/>
    </record>
    <record id="group_odotrans_driver" model="res.groups">
        <field name="name">ODOTRANS / Driver</field>
        <field name="category_id" ref="sa_fleet_logistics.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('sa_fleet_logistics.group_odotrans_user'))]"/>
        <field name="comment">Mobile driver. Restricted to own trips/manifests/POD.</field>
    </record>

    <!-- A driver sees only their own driver record -->
    <record id="rule_driver_own" model="ir.rule">
        <field name="name">Driver: own record only</field>
        <field name="model_id" ref="model_odotrans_driver"/>
        <field name="groups" eval="[(4, ref('group_odotrans_driver'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <!-- Fleet managers see all drivers -->
    <record id="rule_driver_manager" model="ir.rule">
        <field name="name">Driver: managers see all</field>
        <field name="model_id" ref="model_odotrans_driver"/>
        <field name="groups" eval="[(4, ref('group_odotrans_fleet_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
