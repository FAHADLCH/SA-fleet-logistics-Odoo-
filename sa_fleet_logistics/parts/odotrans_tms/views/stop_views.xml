<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stop_list" model="ir.ui.view">
        <field name="name">odotrans.stop.list</field>
        <field name="model">odotrans.stop</field>
        <field name="arch" type="xml">
            <list string="Stops" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="shipment_id"/>
                <field name="stop_type"/>
                <field name="partner_id"/>
                <field name="window_start"/>
                <field name="window_end"/>
                <field name="planned_eta"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_stop_form" model="ir.ui.view">
        <field name="name">odotrans.stop.form</field>
        <field name="model">odotrans.stop</field>
        <field name="arch" type="xml">
            <form string="Stop">
                <header>
                    <button name="action_mark_arrived" type="object" string="Arrived"
                            invisible="state != 'pending'"/>
                    <button name="action_mark_done" type="object" string="Done"
                            invisible="state != 'arrived'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="leg_id"/>
                            <field name="stop_type"/>
                            <field name="partner_id"/>
                            <field name="lat"/>
                            <field name="lng"/>
                        </group>
                        <group>
                            <field name="window_start"/>
                            <field name="window_end"/>
                            <field name="service_time_min"/>
                            <field name="planned_eta"/>
                            <field name="actual_arrival"/>
                            <field name="actual_departure"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stop" model="ir.actions.act_window">
        <field name="name">Stops</field>
        <field name="res_model">odotrans.stop</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
