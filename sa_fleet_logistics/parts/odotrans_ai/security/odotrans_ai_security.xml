<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_odotrans_ai_manager" model="res.groups">
        <field name="name">ODOTRANS AI Manager</field>
        <field name="category_id" ref="sa_fleet_logistics.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('sa_fleet_logistics.group_odotrans_tms_user'))]"/>
    </record>

    <record id="rule_odotrans_ai_insight_company" model="ir.rule">
        <field name="name">ODOTRANS AI Insight: multi-company</field>
        <field name="model_id" ref="model_odotrans_ai_insight"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
