<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_assistant_form" model="ir.ui.view">
        <field name="name">odotrans.ai.assistant.form</field>
        <field name="model">odotrans.ai.assistant</field>
        <field name="arch" type="xml">
            <form string="ODOTRANS AI Assistant">
                <sheet>
                    <div class="oe_title">
                        <h2>Ask ODOTRANS AI</h2>
                    </div>
                    <group>
                        <field name="prompt" placeholder="e.g. show me late shipments to Lahore"/>
                    </group>
                    <group string="Answer" invisible="not answer">
                        <field name="answer" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Suggested Actions" invisible="not actions_json">
                        <field name="actions_json" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_ask" type="object" string="Ask" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ai_assistant" model="ir.actions.act_window">
        <field name="name">AI Assistant</field>
        <field name="res_model">odotrans.ai.assistant</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
