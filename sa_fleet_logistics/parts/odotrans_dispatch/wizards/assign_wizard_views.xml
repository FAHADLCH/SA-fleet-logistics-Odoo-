<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_wizard_form" model="ir.ui.view">
        <field name="name">odotrans.assign.wizard.form</field>
        <field name="model">odotrans.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Vehicle &amp; Driver">
                <group>
                    <field name="trip_ids" widget="many2many_tags"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Vehicle &amp; Driver</field>
        <field name="res_model">odotrans.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_odotrans_trip"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
