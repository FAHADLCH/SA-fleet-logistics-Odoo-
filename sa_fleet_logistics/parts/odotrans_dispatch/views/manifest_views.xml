<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manifest_form" model="ir.ui.view">
        <field name="name">odotrans.manifest.form</field>
        <field name="model">odotrans.manifest</field>
        <field name="arch" type="xml">
            <form string="Manifest">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="trip_id"/>
                        <field name="line_count"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="stop_id"/>
                            <field name="shipment_id"/>
                            <field name="stop_type"/>
                            <field name="planned_eta"/>
                            <field name="stop_state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_manifest" model="ir.actions.act_window">
        <field name="name">Manifests</field>
        <field name="res_model">odotrans.manifest</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
