<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_geofence_list" model="ir.ui.view">
        <field name="name">odotrans.geofence.list</field>
        <field name="model">odotrans.geofence</field>
        <field name="arch" type="xml">
            <list string="Geofences" editable="bottom">
                <field name="name"/>
                <field name="kind"/>
                <field name="center_lat"/>
                <field name="center_lng"/>
                <field name="radius_m"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_geofence_form" model="ir.ui.view">
        <field name="name">odotrans.geofence.form</field>
        <field name="model">odotrans.geofence</field>
        <field name="arch" type="xml">
            <form string="Geofence">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="center_lat"/>
                            <field name="center_lng"/>
                            <field name="radius_m"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_geofence" model="ir.actions.act_window">
        <field name="name">Geofences</field>
        <field name="res_model">odotrans.geofence</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
