<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_position_list" model="ir.ui.view">
        <field name="name">odotrans.position.list</field>
        <field name="model">odotrans.position</field>
        <field name="arch" type="xml">
            <list string="Positions" create="false" edit="false">
                <field name="vehicle_id"/>
                <field name="ts"/>
                <field name="lat"/>
                <field name="lng"/>
                <field name="speed_kph"/>
                <field name="heading"/>
                <field name="source"/>
                <field name="trip_ref"/>
            </list>
        </field>
    </record>

    <record id="action_position" model="ir.actions.act_window">
        <field name="name">Positions</field>
        <field name="res_model">odotrans.position</field>
        <field name="view_mode">list</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
