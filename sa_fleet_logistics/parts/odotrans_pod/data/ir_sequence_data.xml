<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odotrans_pod" model="ir.sequence">
        <field name="name">ODOTRANS POD</field>
        <field name="code">odotrans.pod</field>
        <field name="prefix">POD/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odotrans_exception" model="ir.sequence">
        <field name="name">ODOTRANS Exception</field>
        <field name="code">odotrans.exception</field>
        <field name="prefix">EXC/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
