<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_charge_list" model="ir.ui.view">
        <field name="name">odotrans.charge.list</field>
        <field name="model">odotrans.charge</field>
        <field name="arch" type="xml">
            <list string="Charges" decoration-success="state == 'invoiced'"
                  decoration-muted="state == 'cancelled'">
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="charge_type"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="move_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_charge_form" model="ir.ui.view">
        <field name="name">odotrans.charge.form</field>
        <field name="model">odotrans.charge</field>
        <field name="arch" type="xml">
            <form string="Charge">
                <header>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="customer_id"/>
                            <field name="charge_type"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_charge_search" model="ir.ui.view">
        <field name="name">odotrans.charge.search</field>
        <field name="model">odotrans.charge</field>
        <field name="arch" type="xml">
            <search>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <filter name="draft" string="To Invoice" domain="[('state', '=', 'draft')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state', '=', 'invoiced')]"/>
                <group expand="0" string="Group By">
                    <filter name="g_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="g_type" string="Charge Type" context="{'group_by': 'charge_type'}"/>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_charge" model="ir.actions.act_window">
        <field name="name">Charges</field>
        <field name="res_model">odotrans.charge</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_charge_search"/>
        <field name="context">{'search_default_draft': 1, 'search_default_g_customer': 1}</field>
    </record>
</odoo>
