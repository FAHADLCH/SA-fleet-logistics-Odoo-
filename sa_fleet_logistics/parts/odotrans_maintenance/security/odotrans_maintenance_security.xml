<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_odotrans_maintenance_manager" model="res.groups">
        <field name="name">ODOTRANS Maintenance Manager</field>
        <field name="category_id" ref="sa_fleet_logistics.module_category_odotrans"/>
        <field name="implied_ids" eval="[(4, ref('sa_fleet_logistics.group_odotrans_user'))]"/>
    </record>

    <record id="rule_odotrans_work_order_company" model="ir.rule">
        <field name="name">ODOTRANS Work Order: multi-company</field>
        <field name="model_id" ref="model_odotrans_work_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_odotrans_defect_company" model="ir.rule">
        <field name="name">ODOTRANS Defect: multi-company</field>
        <field name="model_id" ref="model_odotrans_defect"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
