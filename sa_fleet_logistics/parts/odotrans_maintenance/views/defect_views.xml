<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_defect_list" model="ir.ui.view">
        <field name="name">odotrans.defect.list</field>
        <field name="model">odotrans.defect</field>
        <field name="arch" type="xml">
            <list string="Defects" decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'high'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="severity" widget="badge"/>
                <field name="reported_by"/>
                <field name="work_order_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_defect_form" model="ir.ui.view">
        <field name="name">odotrans.defect.form</field>
        <field name="model">odotrans.defect</field>
        <field name="arch" type="xml">
            <form string="Defect">
                <header>
                    <button name="action_create_work_order" type="object" string="Create Work Order"
                            class="oe_highlight" invisible="work_order_id != False or state in ('resolved','dismissed')"/>
                    <button name="action_resolve" type="object" string="Resolve"
                            invisible="state in ('resolved','dismissed')"/>
                    <button name="action_dismiss" type="object" string="Dismiss"
                            invisible="state in ('resolved','dismissed')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="severity"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="reported_by"/>
                            <field name="work_order_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_defect" model="ir.actions.act_window">
        <field name="name">Defects</field>
        <field name="res_model">odotrans.defect</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
