<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_odotrans_work_order" model="ir.sequence">
        <field name="name">ODOTRANS Work Order</field>
        <field name="code">odotrans.work.order</field>
        <field name="prefix">WO/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_odotrans_defect" model="ir.sequence">
        <field name="name">ODOTRANS Defect</field>
        <field name="code">odotrans.defect</field>
        <field name="prefix">DEF/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
