<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webhook_list" model="ir.ui.view">
        <field name="name">odotrans.webhook.endpoint.list</field>
        <field name="model">odotrans.webhook.endpoint</field>
        <field name="arch" type="xml">
            <list string="Webhook Endpoints" decoration-muted="not active"
                  decoration-danger="failure_count > 0">
                <field name="name"/>
                <field name="url"/>
                <field name="topic_filter"/>
                <field name="delivery_count" string="Sent"/>
                <field name="failure_count" string="Failed"/>
                <field name="last_status" optional="show"/>
                <field name="last_delivery" optional="hide"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
                <button name="action_send_test" type="object" string="Ping"
                        icon="fa-paper-plane" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_form" model="ir.ui.view">
        <field name="name">odotrans.webhook.endpoint.form</field>
        <field name="model">odotrans.webhook.endpoint</field>
        <field name="arch" type="xml">
            <form string="Webhook Endpoint">
                <header>
                    <button name="action_send_test" type="object" string="Send Test"
                            class="btn-primary" icon="fa-paper-plane"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer Visibility Feed"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="url" placeholder="https://hooks.partner.com/odotrans"/>
                            <field name="topic_filter"/>
                            <field name="secret" password="True"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Delivery Health">
                            <field name="delivery_count"/>
                            <field name="failure_count"/>
                            <field name="last_status"/>
                            <field name="last_delivery"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Each delivery is POSTed asynchronously with an
                        <code>X-Odotrans-Signature</code> HMAC-SHA256 header when a
                        signing secret is set.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">odotrans.webhook.endpoint</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first webhook endpoint</p>
            <p>Push ODOTRANS events to partner systems in real time.</p>
        </field>
    </record>
</odoo>
