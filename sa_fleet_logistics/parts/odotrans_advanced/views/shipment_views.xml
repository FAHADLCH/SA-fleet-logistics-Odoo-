<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shipment_form_advanced" model="ir.ui.view">
        <field name="name">odotrans.shipment.form.advanced</field>
        <field name="model">odotrans.shipment</field>
        <field name="inherit_id" ref="sa_fleet_logistics.view_shipment_form"/>
        <field name="arch" type="xml">
            <!-- Header actions -->
            <xpath expr="//header" position="inside">
                <button name="action_share_tracking" type="object" string="Share Tracking"
                        icon="fa-share-alt"/>
                <button name="action_create_return" type="object" string="Create Return"
                        icon="fa-undo" invisible="state not in ('delivered','closed')"/>
            </xpath>

            <!-- Smart buttons -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box_advanced">
                    <button name="action_view_appointments" type="object"
                            class="oe_stat_button" icon="fa-calendar-check-o">
                        <field name="appointment_count" widget="statinfo" string="Appointments"/>
                    </button>
                </div>
            </xpath>

            <!-- Quick status badges under the title -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div>
                    <field name="adv_currency_id" invisible="1"/>
                    <field name="access_token" invisible="1"/>
                    <widget name="web_ribbon" title="Return" bg_color="text-bg-warning"
                            invisible="not is_return"/>
                </div>
            </xpath>

            <!-- New notebook pages -->
            <xpath expr="//page[@name='cargo']" position="after">
                <page string="Compliance" name="adv_compliance">
                    <group>
                        <group string="Dangerous Goods">
                            <field name="is_hazmat"/>
                            <field name="un_number" invisible="not is_hazmat"/>
                            <field name="hazmat_class" invisible="not is_hazmat"/>
                            <field name="packing_group" invisible="not is_hazmat"/>
                        </group>
                        <group string="Cold Chain">
                            <field name="temperature_controlled"/>
                            <field name="reefer_required" invisible="not temperature_controlled"/>
                            <field name="temp_min_c" invisible="not temperature_controlled"/>
                            <field name="temp_max_c" invisible="not temperature_controlled"/>
                            <field name="temp_last_c" invisible="not temperature_controlled"/>
                            <field name="temp_breach" invisible="not temperature_controlled"
                                   decoration-danger="temp_breach == True"/>
                        </group>
                    </group>
                </page>
                <page string="Customs" name="adv_customs">
                    <group>
                        <group string="Cross-Border">
                            <field name="is_cross_border"/>
                            <field name="incoterm"/>
                            <field name="hs_code"/>
                            <field name="customs_value"/>
                        </group>
                        <group string="Clearance">
                            <field name="country_origin_id"/>
                            <field name="country_dest_id"/>
                            <field name="customs_status"/>
                        </group>
                    </group>
                </page>
                <page string="Sustainability &amp; Charges" name="adv_sustainability">
                    <group>
                        <group string="Carbon">
                            <field name="region_id"/>
                            <field name="co2_kg"/>
                        </group>
                        <group string="Insurance">
                            <field name="insured_value"/>
                            <field name="insurance_policy"/>
                        </group>
                    </group>
                    <group>
                        <group string="Detention / Demurrage">
                            <field name="detention_start"/>
                            <field name="detention_end"/>
                            <field name="detention_free_min"/>
                            <field name="detention_rate_per_hour"/>
                            <field name="detention_minutes"/>
                            <field name="detention_charge"/>
                        </group>
                        <group string="Reverse Logistics">
                            <field name="is_return"/>
                            <field name="return_reason" invisible="not is_return"/>
                            <field name="original_shipment_id" invisible="not is_return"/>
                            <field name="return_shipment_ids" invisible="is_return"
                                   widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_shipment_list_advanced" model="ir.ui.view">
        <field name="name">odotrans.shipment.list.advanced</field>
        <field name="model">odotrans.shipment</field>
        <field name="inherit_id" ref="sa_fleet_logistics.view_shipment_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="is_hazmat" optional="hide" string="DG"/>
                <field name="temperature_controlled" optional="hide" string="Cold"/>
                <field name="co2_kg" optional="hide" string="CO₂ kg"/>
            </field>
        </field>
    </record>
</odoo>
