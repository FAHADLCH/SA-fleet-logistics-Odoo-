<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enrich existing demo shipments with advanced attributes -->
        <record id="sa_fleet_logistics.demo_ship_transit" model="odotrans.shipment">
            <field name="temperature_controlled" eval="True"/>
            <field name="reefer_required" eval="True"/>
            <field name="temp_min_c">2.0</field>
            <field name="temp_max_c">8.0</field>
            <field name="temp_last_c">5.5</field>
            <field name="insured_value">25000</field>
            <field name="insurance_policy">POL-COLD-4471</field>
        </record>

        <record id="sa_fleet_logistics.demo_ship_exception" model="odotrans.shipment">
            <field name="is_hazmat" eval="True"/>
            <field name="un_number">UN1203</field>
            <field name="hazmat_class">3</field>
            <field name="packing_group">ii</field>
            <field name="is_cross_border" eval="True"/>
            <field name="incoterm">DAP</field>
            <field name="hs_code">2710.12</field>
            <field name="customs_value">48000</field>
            <field name="customs_status">held</field>
        </record>

        <record id="sa_fleet_logistics.demo_ship_delivered" model="odotrans.shipment">
            <field name="insured_value">12000</field>
            <field name="detention_start" eval="(DateTime.now() - timedelta(hours=5))"/>
            <field name="detention_end" eval="(DateTime.now() - timedelta(hours=1))"/>
            <field name="detention_free_min">120</field>
            <field name="detention_rate_per_hour">45</field>
        </record>

        <!-- Dock appointments -->
        <record id="demo_appt_inbound" model="odotrans.appointment">
            <field name="shipment_id" ref="sa_fleet_logistics.demo_ship_transit"/>
            <field name="partner_id" ref="sa_fleet_logistics.demo_depot_central"/>
            <field name="direction">inbound</field>
            <field name="dock">D-04</field>
            <field name="state">confirmed</field>
            <field name="start_datetime" eval="(DateTime.now() + timedelta(hours=3))"/>
            <field name="end_datetime" eval="(DateTime.now() + timedelta(hours=4))"/>
        </record>

        <record id="demo_appt_outbound" model="odotrans.appointment">
            <field name="shipment_id" ref="sa_fleet_logistics.demo_ship_delivered"/>
            <field name="partner_id" ref="sa_fleet_logistics.demo_depot_central"/>
            <field name="direction">outbound</field>
            <field name="dock">D-11</field>
            <field name="state">done</field>
            <field name="start_datetime" eval="(DateTime.now() - timedelta(days=1, hours=2))"/>
            <field name="end_datetime" eval="(DateTime.now() - timedelta(days=1, hours=1))"/>
        </record>
    </data>
</odoo>
