<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_settlement_run_list" model="ir.ui.view">
        <field name="name">odotrans.settlement.run.list</field>
        <field name="model">odotrans.settlement.run</field>
        <field name="arch" type="xml">
            <list string="Settlement Runs" decoration-success="state == 'posted'"
                  decoration-info="state in ('computing','computed')">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="statement_count"/>
                <field name="total_amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_settlement_run_form" model="ir.ui.view">
        <field name="name">odotrans.settlement.run.form</field>
        <field name="model">odotrans.settlement.run</field>
        <field name="arch" type="xml">
            <form string="Settlement Run">
                <header>
                    <button name="action_compute" type="object" string="Compute"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post"
                            class="oe_highlight" invisible="state != 'computed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('posted','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computing,computed,posted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="statement_count"/>
                            <field name="total_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <field name="statement_ids">
                        <list>
                            <field name="name"/>
                            <field name="driver_id"/>
                            <field name="amount" sum="Total"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_settlement_run" model="ir.actions.act_window">
        <field name="name">Settlement Runs</field>
        <field name="res_model">odotrans.settlement.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pay_statement_form" model="ir.ui.view">
        <field name="name">odotrans.pay.statement.form</field>
        <field name="model">odotrans.pay.statement</field>
        <field name="arch" type="xml">
            <form string="Pay Statement">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="driver_id"/>
                            <field name="run_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="trip_id"/>
                            <field name="accrual_id"/>
                            <field name="amount" sum="Total"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pay_statement" model="ir.actions.act_window">
        <field name="name">Pay Statements</field>
        <field name="res_model">odotrans.pay.statement</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
