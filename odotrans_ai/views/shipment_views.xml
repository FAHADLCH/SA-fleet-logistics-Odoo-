<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add AI intelligence to the shipment form: smart button, toolbar action
         and a dedicated AI page with the predictive fields. -->
    <record id="view_shipment_form_ai" model="ir.ui.view">
        <field name="name">odotrans.shipment.form.ai</field>
        <field name="model">odotrans.shipment</field>
        <field name="inherit_id" ref="odotrans_tms.view_shipment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_ai_analyze" type="object" string="AI Analyze"
                        class="btn-secondary" icon="fa-magic"/>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_ai_insights" type="object"
                            class="oe_stat_button" icon="fa-lightbulb-o">
                        <field name="ai_insight_count" widget="statinfo" string="AI Insights"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="AI Intelligence" name="ai">
                    <group>
                        <group string="Prediction">
                            <field name="ai_eta"/>
                            <field name="ai_eta_hours"/>
                            <field name="ai_distance_km"/>
                            <field name="ai_last_run"/>
                        </group>
                        <group string="Risk &amp; Price">
                            <field name="ai_delay_risk" widget="progressbar"/>
                            <field name="ai_risk_level" widget="badge"
                                   decoration-danger="ai_risk_level == 'high'"
                                   decoration-warning="ai_risk_level == 'medium'"
                                   decoration-success="ai_risk_level == 'low'"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="ai_price_suggestion"/>
                        </group>
                    </group>
                    <group string="AI Reasoning">
                        <field name="ai_explanation" nolabel="1" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Surface risk on the shipment list. -->
    <record id="view_shipment_list_ai" model="ir.ui.view">
        <field name="name">odotrans.shipment.list.ai</field>
        <field name="model">odotrans.shipment</field>
        <field name="inherit_id" ref="odotrans_tms.view_shipment_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="ai_risk_level" widget="badge" optional="show"
                       decoration-danger="ai_risk_level == 'high'"
                       decoration-warning="ai_risk_level == 'medium'"
                       decoration-success="ai_risk_level == 'low'"/>
            </field>
        </field>
    </record>
</odoo>
