<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exception_list" model="ir.ui.view">
        <field name="name">odotrans.exception.list</field>
        <field name="model">odotrans.exception</field>
        <field name="arch" type="xml">
            <list string="Exceptions" decoration-warning="state == 'open'"
                  decoration-muted="state == 'resolved'">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="stop_id"/>
                <field name="reason"/>
                <field name="resolution"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_exception_form" model="ir.ui.view">
        <field name="name">odotrans.exception.form</field>
        <field name="model">odotrans.exception</field>
        <field name="arch" type="xml">
            <form string="Exception">
                <header>
                    <button name="action_resolve" type="object" string="Resolve"
                            class="oe_highlight" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="stop_id"/>
                            <field name="shipment_id" readonly="1"/>
                            <field name="driver_id"/>
                            <field name="trip_ref"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="resolution"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Details..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_exception" model="ir.actions.act_window">
        <field name="name">Exceptions</field>
        <field name="res_model">odotrans.exception</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
